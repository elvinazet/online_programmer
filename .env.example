# Скопируйте в .env и настройте значения. Файл .env в git не коммитится.

# Приложение
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (используется контейнером db и строкой DATABASE_URL)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=online_programmer
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/online_programmer

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — ОБЯЗАТЕЛЬНО задайте длинный случайный секрет в проде
JWT_SECRET=change-me-please-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email: console = печать в лог (dev); smtp = реальная отправка
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@online-programmer.local
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
