FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Docker CLI для запуска sandbox-контейнеров через смонтированный docker.sock
# (sibling-контейнеры на хосте). Берём готовый бинарник из официального образа
# docker:cli (реестр docker.io) — не тянем с download.docker.com, который
# недоступен в закрытых сетях.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
